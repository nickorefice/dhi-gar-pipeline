# Copy to config.env and fill in. The pipeline library (embedded in
# .github/actions/pipeline-env/action.yaml) and the operator scripts source this.
# In CI these same names arrive as repo variables / job env instead of a file,
# which is why nothing here is a secret: secrets go to the GitHub secret store
# (Docker Hub PAT) or are minted at runtime by Workload Identity Federation (GCP).

# ---------------------------------------------------------------------------
# Docker Hub side (source of the mirrored DHI image)
# ---------------------------------------------------------------------------
DOCKERHUB_ORG=nicksdemoorg

# Registry holding the signed attestations for the mirrored repo. DHI keeps
# attestations in a *separate* registry from the image, which is the reason this
# pipeline needs regctl's --referrers-src / --external flags at all.
SCOUT_REGISTRY=registry.scout.docker.com

# Username for `regctl registry login`. The PAT itself is never stored here --
# export DOCKERHUB_PAT in your shell, or let CI inject it from secrets.
DOCKERHUB_USERNAME=

# ---------------------------------------------------------------------------
# GCP side (destination)
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=REPLACE_ME
GAR_LOCATION=us-central1
GAR_QUARANTINE_REPO=dhi-quarantine
GAR_PROD_REPO=dhi-prod

# Evidence bucket. Terraform creates gs://${GCP_PROJECT_ID}-dhi-evidence; this
# stands in for the customer's SharePoint/GRC store.
EVIDENCE_BUCKET=REPLACE_ME-dhi-evidence

# ---------------------------------------------------------------------------
# GitHub side
# ---------------------------------------------------------------------------
GITHUB_OWNER=REPLACE_ME
GITHUB_REPO=dhi-gar-pipeline

# ---------------------------------------------------------------------------
# Pipeline defaults
# ---------------------------------------------------------------------------
# Repository under the Hub org to mirror, e.g. dhi-node. Overridable per run.
REPO=dhi-node
# DHI repos have NO "latest" tag -- use a real one (e.g. 24-alpine, 26-debian13-fips).
# List them with: regctl tag ls docker.io/<org>/<repo>
TAG=24-alpine

# Platform pinned for verification and scanning. The *copy* always moves the
# full multi-platform index; this only narrows which manifest the gates inspect,
# because attestations are attached per-platform.
VERIFY_PLATFORM=linux/amd64

# Read-only Docker Hub PAT file (see .secrets/README.md). Optional where the
# environment injects docker.io credentials, but REQUIRED for the attestation
# registry registry.scout.docker.com.
#DOCKERHUB_PAT_FILE=/path/to/.secrets/dockerhub-pat

# Gate severity threshold for the scan gate (docker-scout cves). Written
# uppercase here and lowercased for Scout at the call site; the gate counts
# exactly these severities, so raising it to MEDIUM,HIGH,CRITICAL really does
# make MEDIUM findings block a promotion.
SCAN_SEVERITY=HIGH,CRITICAL

# EGRESS. The scan gate is docker-scout, whose CVE matching is SERVER-SIDE --
# there is no local vulnerability database and no offline mode. Wherever egress
# is allowlisted, both of these must be reachable or the gate fails closed:
#
#   api.dso.docker.com          CVE matching (docker-scout cves, and the CVE
#                               enrichment docker-scout policy performs first)
#   registry.scout.docker.com   DHI VEX and SBOM attestations (also SCOUT_REGISTRY below)
#
# This is a real availability dependency: a Docker Scout outage blocks promotion
# rather than passing it. That is the correct direction to fail, but it is a
# deliberate trade the Trivy implementation did not carry.

# Optional JSON configuring the Rego policy gate -- enablement, weights, and
# per-policy inputs (see policy/dhi-provenance.rego for the keys it reads).
# Absent means every policy in policy/ runs with its built-in defaults.
#POLICY_CONFIG=/path/to/policy-config.json
