# Copy to config.env and fill in. Every script sources this via scripts/lib/common.sh.
# In CI these same names arrive as repo variables / job env instead of a file,
# which is why nothing here is a secret: secrets go to the GitHub secret store
# (Docker Hub PAT) or are minted at runtime by Workload Identity Federation (GCP).

# ---------------------------------------------------------------------------
# Docker Hub side (source of the mirrored DHI image)
# ---------------------------------------------------------------------------
DOCKERHUB_ORG=nicksdemoorg

# Registry holding the signed attestations for the mirrored repo. DHI keeps
# attestations in a *separate* registry from the image, which is the reason this
# pipeline needs regctl's --referrers-src / --external flags at all.
SCOUT_REGISTRY=registry.scout.docker.com

# Username for `regctl registry login`. The PAT itself is never stored here --
# export DOCKERHUB_PAT in your shell, or let CI inject it from secrets.
DOCKERHUB_USERNAME=

# ---------------------------------------------------------------------------
# GCP side (destination)
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=REPLACE_ME
GAR_LOCATION=us-central1
GAR_QUARANTINE_REPO=dhi-quarantine
GAR_PROD_REPO=dhi-prod

# Evidence bucket. Terraform creates gs://${GCP_PROJECT_ID}-dhi-evidence; this
# stands in for the customer's SharePoint/GRC store.
EVIDENCE_BUCKET=REPLACE_ME-dhi-evidence

# ---------------------------------------------------------------------------
# GitHub side
# ---------------------------------------------------------------------------
GITHUB_OWNER=REPLACE_ME
GITHUB_REPO=dhi-gar-pipeline

# ---------------------------------------------------------------------------
# Pipeline defaults
# ---------------------------------------------------------------------------
# Repository under the Hub org to mirror, e.g. dhi-node. Overridable per run.
REPO=dhi-node
TAG=latest

# Platform pinned for verification and scanning. The *copy* always moves the
# full multi-platform index; this only narrows which manifest the gates inspect,
# because attestations are attached per-platform.
VERIFY_PLATFORM=linux/amd64

# Gate severity threshold for Trivy.
SCAN_SEVERITY=HIGH,CRITICAL

# Trivy vulnerability database source. Trivy defaults to mirror.gcr.io and only
# falls back to ghcr.io; pinning it keeps the scan gate to a single registry host,
# which matters wherever egress is allowlisted.
TRIVY_DB_REPOSITORY=ghcr.io/aquasecurity/trivy-db:2
